	"item": [
		{
			"name": "Authentication & Keycloak",
			"item": [
				{
					"name": "Keycloak Fetch Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"token\", jsonData.access_token);",
									"    console.log(\"OAuth2 Access Token cached successfully!\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "client_id",
									"value": "{{client_id}}",
									"type": "text"
								},
								{
									"key": "username",
									"value": "user@email.com",
									"type": "text",
									"description": "Replace with user email"
								},
								{
									"key": "password",
									"value": "password123",
									"type": "text",
									"description": "Replace with user password"
								},
								{
									"key": "grant_type",
									"value": "password",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
							"host": [
								"{{keycloak_url}}"
							],
							"path": [
								"realms",
								"{{realm}}",
								"protocol",
								"openid-connect",
								"token"
							]
						},
						"description": "Requests an access token directly from Keycloak via the Resource Owner Password Credentials flow."
					},
					"response": []
				},
