# =============================================================
# Docker Compose Environment Variables -- Local Development
# =============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored and will NEVER be committed.
#
# For Render deployment: set these variables in the
# Render dashboard -> Environment section instead.
# =============================================================

# PostgreSQL
POSTGRES_DB=expensehub_db
POSTGRES_USER=expensehub_user
POSTGRES_PASSWORD=your_strong_password_here

# Keycloak Admin Console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_strong_keycloak_password_here
